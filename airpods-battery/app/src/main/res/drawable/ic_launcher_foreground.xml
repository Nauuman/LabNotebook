<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- battery ring track -->
    <path
        android:pathData="M38.44,69.56A22,22 0,1 1,69.56 69.56"
        android:strokeWidth="5"
        android:strokeColor="#33FFFFFF"
        android:strokeLineCap="round" />
    <!-- battery ring level -->
    <path
        android:pathData="M38.44,69.56A22,22 0,0 1,69.56 38.44"
        android:strokeWidth="5"
        android:strokeColor="#FF34E89E"
        android:strokeLineCap="round" />
    <!-- earbud stem: a lit cylinder -->
    <path android:pathData="M53,48h5v16a2.5,2.5 0,0 1,-5 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="58"
                android:endY="0"
                android:startX="53"
                android:startY="0"
                android:type="linear">
                <item android:color="#FFCFD0D7" android:offset="0" />
                <item android:color="#FFFFFFFF" android:offset="0.4" />
                <item android:color="#FFA6A7B0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- silver tip -->
    <path
        android:fillColor="#FFB4B6BE"
        android:pathData="M53,62.5h5v1.5a2.5,2.5 0,0 1,-5 0z" />
    <!-- earbud head: a sphere lit from the top left -->
    <path android:pathData="M44,48a7,7 0,1 0,14 0a7,7 0,1 0,-14 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48.5"
                android:centerY="45.5"
                android:gradientRadius="10"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFEDEDF1" android:offset="0.5" />
                <item android:color="#FFB0B1B9" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- speaker grille -->
    <path
        android:fillColor="#FF2C2C2E"
        android:pathData="M45.6,48.6a1.9,1.3 0,1 0,3.8 0a1.9,1.3 0,1 0,-3.8 0z" />
</vector>
